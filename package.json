    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.0.2",
    "react-pdf": "^10.4.1",
    "react-router-dom": "^6.26.2",
    "tailwind-merge": "^2.5.2"
